# 基于哪个镜像部署,镜像名称:版本
FROM 10.151.129.200:180/public/openjdk:8u275
# 镜像创建者
MAINTAINER 谭永强
# 拷贝文件夹下的文件到镜像中的app.jar
ADD @project.artifactId@-@project.version@-@env@.jar app.jar
# 拷贝SkyWalking-agent.tgz
#ADD http://10.212.21.29:8888/group1/M00/00/00/CtQVHWW6-aCANQ-UAeUmGw-Obhc481.tgz /
# 拷贝SkyWalking-agent.tgz
#RUN tar zxvf CtQVHWW6-aCANQ-UAeUmGw-Obhc481.tgz
# 拷贝SkyWalking-agent.tgz
#RUN rm -rf CtQVHWW6-aCANQ-UAeUmGw-Obhc481.tgz
# 设置时区
RUN /bin/cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo 'Asia/Shanghai' >/etc/timezone
# jvm参数设置
ENV JAVA_OPTS="-Xmx3700m -Xms3700m -Duser.timezone=GMT+8"
#ENV AGENT_OPTS="-javaagent:/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=scps-sys-server -Dskywalking.collector.backend_service=10.212.21.100:11800"
# 配置容器启动后执行的命令
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app.jar"]