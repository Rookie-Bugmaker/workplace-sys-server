pipeline {
  agent {
    node {
      label 'maven'
    }
  }
  stages {
    stage('代码克隆') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER == ''
        }
      }
      steps {
        container('maven') {
          git(url: 'http://172.22.212.45/workplace-new/rear-end/basic/scps-sys-server.git', credentialsId: 'gitlab', branch: 'master', changelog: true, poll: false)
        }
      }
    }

    stage('项目编译') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER == ''
        }
      }
      steps {
        container('maven') {
          sh 'mvn clean package -P $PROFILE'
        }

      }
    }

    stage('构建镜像') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER == ''
        }
      }
      steps {
        container('maven') {
          sh 'cd target/ && mv classes/Dockerfile-$PROFILE ./ && docker build -f Dockerfile-$PROFILE -t $REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:$APP_VERSION-$PROFILE-$BUILD_NUMBER . '
        }
      }
    }

    stage('推送镜像') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER == ''
        }
      }
      steps {
        container('maven') {
          withCredentials([usernamePassword(credentialsId : 'harbor-login-registry' ,passwordVariable : 'DOCKER_PASSWORD' ,usernameVariable : 'DOCKER_USERNAME' ,)]) {
            sh 'echo "$DOCKER_PASSWORD" | docker login $REGISTRY -u "$DOCKER_USERNAME" --password-stdin'
            sh 'docker push $REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:$APP_VERSION-$PROFILE-$BUILD_NUMBER'
            // 删除当前镜像(可选)
            sh 'docker rmi $REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:$APP_VERSION-$PROFILE-$BUILD_NUMBER'
          }
        }
      }
    }

    stage('部署') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER == ''
        }
      }
      environment {
        MY_BUILD_NUMBER = "${BUILD_NUMBER}"
      }
      steps {
        container('maven') {
          withCredentials([kubeconfigContent(credentialsId : 'demo-kubeconfig' ,variable : 'KUBECONFIG_CONFIG')]) {
            sh 'echo 部署镜像版本:$REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:$APP_VERSION-$PROFILE-$MY_BUILD_NUMBER'
            sh 'mkdir -p ~/.kube'
            sh 'echo "$KUBECONFIG_CONFIG" > ~/.kube/config'
            sh 'envsubst < target/classes/k8s/deployment-$PROFILE.yaml | kubectl apply -f -'
          }
        }
      }
    }

    stage('部署[回滚]') {
      agent none
      when {
        expression {
          params.MY_BUILD_NUMBER != ''
        }
      }
      steps {
        container('maven') {
          withCredentials([kubeconfigContent(credentialsId : 'demo-kubeconfig' ,variable : 'KUBECONFIG_CONFIG')]) {
            sh 'echo 部署镜像版本:$REGISTRY/$DOCKERHUB_NAMESPACE/$APP_NAME:$APP_VERSION-$PROFILE-$MY_BUILD_NUMBER'
            sh 'mkdir -p ~/.kube'
            sh 'echo "$KUBECONFIG_CONFIG" > ~/.kube/config'
            sh 'envsubst < target/classes/k8s/deployment-$PROFILE.yaml | kubectl apply -f -'
          }
        }
      }
    }

  }
  environment {
    KUBECONFIG_CREDENTIAL_ID = 'demo-kubeconfig'
    REGISTRY = '10.212.22.11:180'
    DOCKERHUB_NAMESPACE = 'v5'
    APP_NAME = 'scps-sys-server'
    APP_VERSION = '5.0.0'
    PROFILE = 'product'
  }
  parameters {
    string(name: 'MY_BUILD_NUMBER', defaultValue: '', description: '指定镜像版本(运行ID)')
  }
}