<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cccr.sys.mapper.SysRoleOrgMapper" >

    <!--角色组织新增-->
    <insert id="insert" parameterType="java.util.List">
        insert into sys_role_org (role_id,org_id,create_by,create_date) VALUES
        <foreach collection="roleOrgList" item="item" separator=",">
            (#{item.roleId},#{item.orgId},#{item.createBy},#{item.createDate})
        </foreach>
    </insert>

    <!--角色组织删除-->
    <insert id="deleteByRoleId" parameterType="java.lang.Long">
        delete from sys_role_org where role_id = #{roleId}
    </insert>

    <!--角色组织删除-->
    <insert id="deleteByRoleIds" parameterType="java.util.List">
        delete from sys_role_org where role_id in
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </insert>
</mapper>