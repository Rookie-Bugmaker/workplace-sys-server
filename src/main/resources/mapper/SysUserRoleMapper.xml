<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.crrc.sys.mapper.SysUserRoleMapper" >

    <resultMap id="roleMap" type="com.crrc.sys.entity.role.SysRole">
        <id column="ROLE_ID" property="roleId" jdbcType="NUMERIC" />
        <result column="ROLE_CODE" property="roleCode" jdbcType="VARCHAR" />
        <result column="ROLE_NAME" property="roleName" jdbcType="VARCHAR" />
        <result column="ROLE_DESCRIPTION" property="roleDescription" jdbcType="VARCHAR" />
        <result column="ENABLE_FLAG" property="enableFlag" jdbcType="VARCHAR" />
    </resultMap>

    <!--根据用户ID查询拥有的角色ID集合-->
    <select id="findByUserId" resultMap="roleMap">
        select r.role_id,r.role_code,r.enable_flag,rtl.role_name,rtl.role_description
        from sys_role_b r
        join sys_role_tl rtl on r.role_id = rtl.role_id and rtl.language = #{language}
        join sys_user_role ur on ur.role_id = r.role_id
        where ur.user_id = #{userId}
    </select>

    <!--用户角色添加-->
    <insert id="insert" parameterType="java.util.List">
        insert into sys_user_role (id,user_id,role_id,create_by,create_date) values
        <foreach collection="userRoleList" item="item" separator=",">
            (#{item.id},#{item.userId},#{item.roleId},#{item.createBy},#{item.createDate})
        </foreach>
    </insert>

    <!--根据用户ID删除用户角色中间表数据-->
    <delete id="deleteByUserId" parameterType="java.lang.Long">
        delete from sys_user_role where user_id = #{userId}
    </delete>

    <!--根据用户ID查询拥有的角色ID集合-->
    <select id="findRoleIdByUserId" resultType="java.lang.Long">
		select r.role_id
		from sys_user_role ur
		join sys_role_b r on r.role_id = ur.role_id
		where ur.user_id = #{userId}
	</select>

    <!--根据角色ID查询绑定的用户ID集合-->
    <select id="findUserIdByRoleId" resultType="java.lang.Long">
        select ur.user_id from sys_user_role ur where ur.role_id = #{roleId}
    </select>

    <!--  根据用户ids查询角色编码-->
    <select id="findUserRoleByUserIdOrUserName" resultType="com.crrc.sys.model.user.role.SysUserRoleDTO">
        SELECT
        s.*,
        b.ROLE_CODE,
        su.USER_NAME
        FROM sys_user_role s
        LEFT JOIN sys_role_b b ON s.role_id = b.role_id
        LEFT JOIN sys_user su ON su.user_id = s.USER_ID
        <where>
            <if test="userIds != null and userIds.size() > 0">
                AND su.user_id IN
                <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
            <if test="userNames != null and userNames.size() > 0">
                AND su.user_name IN
                <foreach collection="userNames" item="userName" open="(" separator="," close=")">
                    #{userName}
                </foreach>
            </if>
        </where>
    </select>

    <!--用户角色中间表删除-->
    <delete id="deleteByRoleIds">
        delete from sys_user_role where role_id in
        <foreach collection="roleIdList" item="roleId" open="(" separator="," close=")">
          #{roleId}
        </foreach>
    </delete>

</mapper>