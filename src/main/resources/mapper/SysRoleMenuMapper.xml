<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.crrc.sys.mapper.SysRoleMenuMapper" >

    <resultMap id="roleMenuMap" type="com.crrc.sys.entity.role.SysRoleMenu">
        <result column="ROLE_ID" property="roleId" jdbcType="NUMERIC" />
        <result column="MENU_ID" property="menuId" jdbcType="NUMERIC" />
        <result column="HALF_CHECKED" property="halfChecked" jdbcType="BOOLEAN" />
    </resultMap>

    <!--根据菜单ID删除角色菜单中间表数据-->
    <delete id="deleteByMenuIds" parameterType="java.util.List">
        delete from sys_role_menu where menu_id in
        <foreach collection="menuIdList" item="menuId" open="(" separator="," close=")">
            #{menuId}
        </foreach>
    </delete>

    <!--角色菜单添加-->
    <insert id="insert" parameterType="java.util.List">
        insert into sys_role_menu (role_id,menu_id,half_checked,child_flag,create_by,create_date) VALUES
        <foreach collection="roleMenuList" item="item" separator=",">
            (#{item.roleId},#{item.menuId},#{item.halfChecked},#{item.childFlag},#{item.createBy},#{item.createDate})
        </foreach>
    </insert>

    <!--根据角色ID删除角色菜单数据-->
    <delete id="deleteByRoleId" parameterType="java.lang.Long">
        delete from sys_role_menu where role_id = #{roleId}
    </delete>

    <!--根据角色ID删除角色菜单数据(批量)-->
    <delete id="deleteByRoleIds" parameterType="java.util.List">
        delete from sys_role_menu where role_id in
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <!--根据角色ID查询拥有的菜单ID-->
    <select id="findByRoleId" resultMap="roleMenuMap" parameterType="java.lang.Long">
        select role_id, menu_id,half_checked from sys_role_menu where role_id = #{roleId} and child_flag = 0
    </select>
</mapper>