[1001]

### 6. 根据编码查询
GET {{prefix}}/test/profile/findByCode?profileCode=TEST_SYS_CONFIG_0011
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}

### 7. 执行动态SQL
POST {{prefix}}/test/profile/executeSql
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}
Content-Type: application/json

{
  "fuzzyQuery": "系统",
  "profileValueColumn": "menu_id",
  "profileCodeColumn": "menu_code",
  "profileDescColumn": "menu_name",
  "profileParentColumn": "parent_id",
  "sql": "select mb.menu_id,mb.menu_code,mb.parent_id,mtl.menu_name,mtl.menu_description from sys_menu_b mb join sys_menu_tl mtl on mtl.menu_id = mb.menu_id and mtl.language = 'ZH-CN' join sys_role_menu rm on rm.menu_id = mb.menu_id"
}

### 8. 根据类型查询
GET {{prefix}}/test/profile/findByType?profileType=SYS_DATA_PERMISSION&language=zh-CN
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}

### 9. 批量ID查询
POST {{prefix}}/test/profile/findByIds?language=zh-CN
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}
Content-Type: application/json

[1001, 439736949640585216]

