### 1. 模糊查询API接口
POST {{prefix}}/test/sysApi/findByFuzzy
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}
Content-Type: application/json

{
  "apiName": "按id删除",
  "apiUri": "/user",
  "description": "管理",
  "pageNum": 1,
  "pageSize": 10
}

### 2. 新增API接口
POST {{prefix}}/test/sysApi
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}
Content-Type: application/json

{
  "id": 2003,
  "apiName": "高铁转向架数据接口3",
  "apiUri": "/api/train/bogie-data",
  "apiMethod": "POST",
  "apiDesc": "用于获取CR400BF型高铁转向架的实时传感器数据",
  "createBy": 1001,
  "createDate": "2024-03-15 09:30:00",
  "lastUpdateBy": 1002,
  "lastUpdateDate": "2024-03-20 14:15:00",
  "lastUpdateLogin": 3001
}

