### 1. 添加主页组件
POST {{prefix}}/test/homePageComponent/add
Content-Type: application/json
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}

{
  "componentId": 1001,
  "homePageTitle": "TEST-生产看板",
  "functionName": "TEST-生产进度监控",
  "functionCode": "TEST-PROD_MONITOR",
  "refreshRate": 30,
  "loadingType": 1,
  "userType": "TEST-工艺工程师",
  "remarks": "测试数据-生产看板组件",
  "status": "Y",
  "showStatus": "Y",
  "functionUrl": "/test/prod-monitor",
  "businessAreaName": "TEST-车体生产",
  "createBy": 9001,
  "createDate": "2025-03-22 09:15:00",
  "lastUpdateBy": 9001,
  "lastUpdateDate": "2025-03-22 15:30:00",
  "lastUpdateLogin": 123456
}

### 2. 查询主页组件列表
GET {{prefix}}/test/homePageComponent/findList?status=Y
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}

### 3. 删除主页组件
DELETE {{prefix}}/test/homePageComponent/deleteById/1001
X-Project-Code: {{projectCode}}
Authorization: {{authToken}}

